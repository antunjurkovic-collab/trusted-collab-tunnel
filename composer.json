{
    "name": "antunjurkovic/trusted-collab-tunnel",
    "description": "Internal WordPress reference implementation of Collaboration Content Transfer Draft-03.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TCT\\Compatibility\\Doctor\\": "src/Compatibility/Doctor/",
            "TCT\\Compatibility\\WordPress\\": "includes/Compatibility/",
            "TCT\\Draft03\\": "src/Draft03/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TCT\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
